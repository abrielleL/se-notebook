node_modules/
.env
.env.local
*.log
.DS_Store
dist/
build/
server/uploads/*
!server/uploads/.gitkeep
.vscode/
.idea/

# Database & sidecar files (contain account data + OAuth tokens) — never commit
server/db/*.db
server/db/*.db-shm
server/db/*.db-wal
server/db/*.db.bak-*
server/db/token.json
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Local backups of the database (full data copies)
backups/

# Stray / exported artifacts that may contain customer data
files.zip
POV_*_test-export.docx
*.docx
!pov-template.docx

# Per-machine tooling state (contains local home paths / personal allowlists)
.claude/settings.local.json
hydrate.progress
__pycache__/
*.pyc

# OPSWAT brand kit bundle. Contains Simplon Norm, which is licensed from
# Lineto — not for redistribution via this repo. Installed as a Claude Code
# skill at ~/.claude/skills/opswat-branding/ instead. The logo SVGs the app
# actually renders are committed under client/src/assets/.
opswat-branding.skill

# Corrupt DB copies kept for forensics after the 2026-08-20 OneDrive corruption.
server/db/*.CORRUPT-*
