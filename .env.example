# Copy this file to .env and fill in real values.
# None of these are required to run the core app — Microsoft Graph is only
# needed for Outlook/Teams calendar sync.

PORT=3001

# Microsoft Graph (Outlook/Teams meeting sync) — register an app in Entra ID.
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# Optional: the Claude API key is normally entered in the app's Settings UI and
# stored in the browser. Setting it here lets the server honor it as a fallback.
ANTHROPIC_API_KEY=your_anthropic_api_key
